{
  "name": "job-ops-orchestrator",
  "version": "0.14.0",
  "description": "Unified orchestrator for job application pipeline",
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vp dev --host",
    "ladle": "ladle serve",
    "ladle:build": "ladle build --outDir storybook-static",
    "check:all": "npm run check:types && npm run check:fix && npm run format:fix",
    "ci": "vp check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "check:types": "tsc --noEmit",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "build:client": "vp build",
    "build:do": "node scripts/build-do-entry.mjs",
    "build:pdf-worker": "node scripts/build-pdf-worker.mjs",
    "start": "tsx src/server/index.ts",
    "benchmark:jobs": "tsx scripts/benchmark-jobs.ts",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:migrate:prod": "tsx src/server/db/migrate.ts",
    "db:clear": "tsx src/server/db/clear.ts",
    "db:drop": "tsx src/server/db/clear.ts --drop",
    "pipeline:run": "tsx src/server/pipeline/run.ts",
    "test": "vp test",
    "test:run": "vp test run"
  },
