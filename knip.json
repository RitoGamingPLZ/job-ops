{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["-lintignore"],
  "ignoreDependencies": ["vitest"],
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "workspaces": {
    ".": {
      "entry": [],
      "project": [],
      "ignoreDependencies": ["tsx"]
    },
    "docs-site": {
      "entry": ["src/theme/**/*.tsx", "src/css/custom.css", "src/**/*.test.ts"]
    },
    "orchestrator": {
      "entry": [
        "src/server/do-entry.ts",
        "src/server/pdf-worker.ts",
        "vite.config.ts",
        "src/setupTests.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/components/ui/**"],
      "ignoreDependencies": ["@tailwindcss/typography", "tw-animate-css"],
      "ignoreUnresolved": ["vite/client"]
    },
    "shared": {
      "project": ["src/**/*.ts"],
      "ignore": ["src/**/*.test.ts"]
    },
    "career-boards/*": {
      "entry": ["src/**/*.test.ts"]
    },
    "extractors/*": {
      "entry": ["{,src/}manifest.ts", "tests/**/*.test.ts"]
    },
    "extractors/browser-utils": {
      "entry": ["tests/**/*.test.ts"]
    }
  }
}
