# Dependencies
**/node_modules
**/.venv
**/__pycache__

# Build outputs
**/dist
# The Cloudflare container runs this prebuilt bundle (see cloudflare/Dockerfile). Wrangler pipes
# the Dockerfile in on stdin, so cloudflare/Dockerfile.dockerignore is never read and this file
# is the only one that applies.
!orchestrator/dist/pdf-worker
!orchestrator/dist/pdf-worker/**
**/*.pyc

# Data (mounted as volume)
data/

# Environment files (passed via docker-compose)
.env
**/.env
**/.env.local

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test files
**/*.test.ts
**/*.spec.ts
**/test/
**/tests/
**/__tests__/

# Documentation
*.md
!README.md

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Docker
Dockerfile*
docker-compose*

# Temporary files
tmp
temp
*.tmp

# Coverage
coverage
.nyc_output
